                <mxCell id="4" value="&lt;p dir=&quot;ltr&quot;&gt;La estructura del modelo lógico es el siguiente:&lt;/p&gt;&lt;ul dir=&quot;ltr&quot;&gt;&lt;li&gt;&lt;strong&gt;USUARIOS&lt;/strong&gt; (id_usuario [PK], nombre, apellido, fecha_registro, activo)&lt;/li&gt;&lt;li&gt;&lt;strong&gt;TELEFONOS_USUARIOS&lt;/strong&gt; (id_usuario [PK/FK], telefono [PK])&lt;/li&gt;&lt;li&gt;&lt;strong&gt;EMAILS_USUARIOS&lt;/strong&gt; (id_usuario, email) (FK: id_usuario → USUARIOS)&lt;/li&gt;&lt;li&gt;&lt;strong&gt;CATEGORIA&lt;/strong&gt; (id_categoria [PK], nombre, id_categoria_padre [FK])&lt;/li&gt;&lt;li&gt;&lt;strong&gt;UBICACIONES&lt;/strong&gt; (id_ubicacion [PK], nombre, direccion, ciudad, capacidad)&lt;/li&gt;&lt;li&gt;&lt;strong&gt;EVENTOS&lt;/strong&gt; (id_evento [PK], titulo, descripcion, fecha_inicio, fecha_fin, id_usuario_propietario [FK], id_categoria [FK], &lt;strong&gt;id_ubicacion [FK]&lt;/strong&gt;)&lt;/li&gt;&lt;li&gt;&lt;strong&gt;PARTICIPACION&lt;/strong&gt; (id_usuario [PK], id_evento [PK], rol, estado_confirmacion)&lt;/li&gt;&lt;li&gt;&lt;strong&gt;BITACORA_ACCESOS&lt;/strong&gt; (id_log [PK], fecha_acceso, id_usuario [PK])&lt;/li&gt;&lt;/ul&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="3">
